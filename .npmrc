auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
# Hosts may run a newer pnpm than the one used locally; never refuse to install because of it.
package-manager-strict=false
engine-strict=false
# pnpm 10+/11 supply-chain policy: do not reject freshly published versions that are already in the lockfile.
minimum-release-age=0
