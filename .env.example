# ============================================================
# OSES J — environment configuration
# Copy to `.env` at the repository root. Never commit `.env`.
# ============================================================

# ---------- Core ----------
NODE_ENV=development
# Public URL of the web app (used for links, OAuth callbacks, CSRF origin checks)
APP_URL=http://localhost:3100
PORT=3100
# Session signing / CSRF secret. Generate: openssl rand -base64 48
AUTH_SECRET=
# 32-byte key (base64) used to encrypt stored secrets (social tokens, provider keys). Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ---------- Database (MySQL / MariaDB) ----------
DATABASE_URL=mysql://root:@127.0.0.1:3306/oses_j_dev
# Optional: used by integration tests (tests are skipped when unset)
TEST_DATABASE_URL=

# ---------- Platform operators (OS-Panel) ----------
# Comma-separated emails granted OS-Panel access on their next login (CNEX AI team only)
SUPER_ADMIN_EMAILS=

# ---------- Jobs / automation ----------
# inline  = process jobs in the web process right after they are enqueued (dev / shared hosting)
# cron    = process jobs only when POST /api/internal/jobs/tick is called (Hostinger cron)
# worker  = process jobs only in the standalone worker (pnpm worker) on a VPS
JOB_RUNNER_MODE=inline
# Secret required by POST /api/internal/jobs/tick (send as Authorization: Bearer <secret>)
INTERNAL_JOB_SECRET=
# mysql is the shipped queue driver. A Redis/BullMQ driver can be added behind the same interface.
QUEUE_DRIVER=mysql
REDIS_URL=
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=3000

# ---------- AI ----------
# anthropic | openai | openai_compatible | none
AI_PROVIDER=anthropic
# Fallback only: the platform AI provider is normally set in OS-Panel → Providers & keys.
# AI_PROVIDER: anthropic | openai | google | xai | deepseek | qwen | mistral | nvidia | groq | together | openrouter | ollama | lmstudio | openai_compatible | none
AI_API_KEY=
AI_MODEL=claude-sonnet-5
# Only for openai_compatible (e.g. https://openrouter.ai/api/v1)
AI_BASE_URL=
# Optional embeddings for the knowledge base (openai | none). Keyword retrieval works without it.
AI_EMBEDDING_PROVIDER=none
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_API_KEY=

# ---------- Apify ----------
# Fallback only: the Google search API is normally set in OS-Panel → Providers & keys.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# Fallback only: the token and default Actors are normally set in OS-Panel → Providers & keys.
APIFY_API_TOKEN=
# Actor IDs are examples; verify the Actor you choose and its input/output schema.
APIFY_INSTAGRAM_DISCOVERY_ACTOR=apify/instagram-scraper
APIFY_INSTAGRAM_PROFILE_ACTOR=apify/instagram-profile-scraper
APIFY_INSTAGRAM_HASHTAG_ACTOR=apify/instagram-hashtag-scraper
# Facebook page details for known page URLs (profile enrichment)
APIFY_FACEBOOK_PAGES_ACTOR=apify/facebook-pages-scraper
# Optional keyword-based Facebook page search Actor (leave empty to rely on the search-engine strategy)
APIFY_FACEBOOK_DISCOVERY_ACTOR=
# Google results restricted to instagram.com / facebook.com (primary strategy for "brands in <city>" queries)
APIFY_SEARCH_ENGINE_ACTOR=apify/google-search-scraper
APIFY_MESSAGING_ACTOR=
APIFY_RUN_TIMEOUT_SEC=600
APIFY_MAX_COST_USD=

# ---------- Meta (Instagram / Facebook official APIs) ----------
# Fallback only: the Meta app is normally set in OS-Panel → Providers & keys.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# ---------- Storage (documents / exports) ----------
STORAGE_DRIVER=local
STORAGE_DIR=./storage

# ---------- Browser extension ----------
EXTENSION_ACCESS_TOKEN_TTL_MINUTES=60
EXTENSION_REFRESH_TOKEN_TTL_DAYS=30

# ---------- Observability ----------
LOG_LEVEL=info
# pretty | json
LOG_FORMAT=pretty
SENTRY_DSN=

# ---------- Misc ----------
TRASH_RETENTION_DAYS=7
DEFAULT_TIMEZONE=Asia/Karachi
