// OSES J database schema (MySQL / MariaDB).
//
// Conventions
// - Every business-owned table carries organizationId (multi-tenancy). Queries must always scope by it.
// - Soft deletes use deletedAt; Trash rows (TrashItem) index what can be restored/purged.
// - Provider raw output is kept separate (raw Json / ProviderRun) from normalized business fields.
// - Contact fields carry source + confidence so inferred data is never presented as verified.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = ""
}

datasource db {
  provider = "mysql"
}

