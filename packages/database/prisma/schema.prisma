/// Idempotency store for inbound webhook events.
model WebhookEvent {
  id              String             @id @default(uuid(7)) @db.Char(36)
  provider        String             @db.VarChar(40)
  externalEventId String             @db.VarChar(191)
  objectType      String?            @db.VarChar(40)
