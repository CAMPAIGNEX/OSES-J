// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid(7)) @db.Char(36)
  email        String   @unique @db.VarChar(191)
  name         String   @db.VarChar(120)
  passwordHash String   @db.VarChar(255)
  timezone     String?  @db.VarChar(64)
  isActive     Boolean  @default(true)
  /** Platform operator (CNEX AI team): grants access to the OS-Panel across all organizations. */
  isSuperAdmin Boolean  @default(false)
  lastLoginAt  DateTime? @db.DateTime(3)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  updatedAt    DateTime @updatedAt @db.DateTime(3)

  sessions    Session[]
  memberships OrganizationMember[]
  auditLogs   AuditLog[]
  devices     ExtensionDevice[]

  @@map("users")
}

model Session {
  id                   String   @id @default(uuid(7)) @db.Char(36)
  userId               String   @db.Char(36)
  tokenHash            String   @unique @db.VarChar(64)
  activeOrganizationId String?  @db.Char(36)
  userAgent            String?  @db.VarChar(255)
  ip                   String?  @db.VarChar(64)
  expiresAt            DateTime @db.DateTime(3)
  lastSeenAt           DateTime @default(now()) @db.DateTime(3)
  createdAt            DateTime @default(now()) @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id                 String  @id @default(uuid(7)) @db.Char(36)
  name               String  @db.VarChar(160)
  slug               String  @unique @db.VarChar(80)
  // Company profile (used by the AI as verified company facts)
  description        String? @db.Text
  website            String? @db.VarChar(500)
  country            String? @db.VarChar(80)
  city               String? @db.VarChar(80)
  address            String? @db.VarChar(300)
  products           String? @db.Text
  moq                String? @db.VarChar(300)
  certifications     String? @db.Text
  shippingInfo       String? @db.Text
  productionCapacity String? @db.VarChar(500)
  contactEmail       String? @db.VarChar(254)
  contactPhone       String? @db.VarChar(40)
  timezone           String  @default("Asia/Karachi") @db.VarChar(64)
  // Platform management (OS-Panel)
  status             OrganizationStatus @default(ACTIVE)
  plan               String  @default("standard") @db.VarChar(40)
  suspendedAt        DateTime? @db.DateTime(3)
  suspendedReason    String? @db.VarChar(300)
  internalNotes      String? @db.Text
  createdAt          DateTime @default(now()) @db.DateTime(3)
  updatedAt          DateTime @updatedAt @db.DateTime(3)
  deletedAt          DateTime? @db.DateTime(3)

  members            OrganizationMember[]
  counters           OrganizationCounter[]
  settings           OrganizationSettings?
  searchRuns         SearchRun[]
  savedSearches      SavedSearch[]
  providerRuns       ProviderRun[]
  leads              Lead[]
  clients            Client[]
  tags               Tag[]
  notes              Note[]
  activities         Activity[]
  socialConnections  SocialConnection[]
  conversations      Conversation[]
  messages           Message[]
  scheduledMessages  ScheduledMessage[]
  messageJobs        MessageJob[]
  extensionDevices   ExtensionDevice[]
  extensionPairings  ExtensionPairing[]
  campaigns          Campaign[]
  aiInstructions     AIInstruction[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks    KnowledgeChunk[]
  aiActionLogs       AIActionLog[]
  automationJobs     AutomationJob[]
  auditLogs          AuditLog[]
  usageRecords       UsageRecord[]
  documents          Document[]
  trashItems         TrashItem[]
  providerConfigs    ProviderConfig[]
  competitorSearches CompetitorSearch[]
  trendSearches      TrendSearch[]
  contentItems       ContentItem[]

  @@map("organizations")
}

model OrganizationMember {
  id             String     @id @default(uuid(7)) @db.Char(36)
  organizationId String     @db.Char(36)
  userId         String     @db.Char(36)
  role           MemberRole @default(MEMBER)
  createdAt      DateTime   @default(now()) @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

/// Atomic per-organization sequences (e.g. client CIDs).
model OrganizationCounter {
  organizationId String @db.Char(36)
  key            String @db.VarChar(40)
  value          Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, key])
  @@map("organization_counters")
}

model OrganizationSettings {
  organizationId              String        @id @db.Char(36)
  messagingMode               MessagingMode @default(MANUAL)
  /// UI template for the workspace (Settings > Appearance): classic | bauhaus
  uiTemplate                  String        @default("classic") @db.VarChar(32)
  autopilotEnabled            Boolean       @default(false)
  autopilotEnabledAt          DateTime?     @db.DateTime(3)
  defaultChannel              Platform      @default(INSTAGRAM)
  workingHours                Json?
  followUpDays                Json?
  messagesPerHour             Int           @default(20)
  messagesPerDay              Int           @default(100)
  minMinutesBetweenMessages   Int           @default(2)
  // AI
  aiProvider                  String?       @db.VarChar(40)
  aiModel                     String?       @db.VarChar(120)
  aiBaseUrl                   String?       @db.VarChar(500)
  aiApiKeyEncrypted           String?       @db.Text
  aiTemperature               Float         @default(0.7)
  aiTone                      String?       @db.VarChar(200)
  aiLanguage                  String?       @db.VarChar(40)
  autoReply                   Boolean       @default(false)
  autoFollowUp                Boolean       @default(false)
  autoFirstMessage            Boolean       @default(false)
  requireApprovalFirstMessage Boolean       @default(true)
  requireApprovalAttachments  Boolean       @default(true)
  confidenceThreshold         Float         @default(0.75)
  escalatePricing             Boolean       @default(true)
  escalateNegotiation         Boolean       @default(true)
  escalateComplaints          Boolean       @default(true)
  escalateUnusual             Boolean       @default(true)
  // Automation
  apifyTokenEncrypted         String?       @db.Text
  apifyEnabled                Boolean       @default(true)
  maxConcurrentJobs           Int           @default(2)
  maxRetries                  Int           @default(3)
  jobTimeoutSec               Int           @default(600)
  extensionEnabled            Boolean       @default(true)
  preferredProvider           String        @default("auto") @db.VarChar(20)
  extra                       Json?
  updatedAt                   DateTime      @updatedAt @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

/// Platform-wide provider credentials and defaults, managed by CNEX AI operators from the OS-Panel.
/// A single row (id = "platform"). Values here are what every workspace uses unless the workspace has
/// its own override; environment variables (APIFY_API_TOKEN, AI_*, META_*) are only the bootstrap fallback.
model PlatformSettings {
  id                       String   @id @default("platform") @db.VarChar(20)
  // Discovery / enrichment (Apify)
  apifyTokenEncrypted      String?  @db.Text
  apifyEnabled             Boolean  @default(true)
  // AI provider used by every workspace without its own key
  aiProvider               String?  @db.VarChar(40)
  aiModel                  String?  @db.VarChar(120)
  aiBaseUrl                String?  @db.VarChar(500)
  aiApiKeyEncrypted        String?  @db.Text
  // Embeddings for the knowledge base
  embeddingProvider        String?  @db.VarChar(40)
  embeddingModel           String?  @db.VarChar(120)
  embeddingApiKeyEncrypted String?  @db.Text
  // Meta app (Facebook Login, Graph API, webhooks)
  metaAppId                String?  @db.VarChar(80)
  metaAppSecretEncrypted   String?  @db.Text
  metaWebhookVerifyToken   String?  @db.VarChar(200)
  updatedByUserId          String?  @db.Char(36)
  createdAt                DateTime @default(now()) @db.DateTime(3)
  updatedAt                DateTime @updatedAt @db.DateTime(3)

  @@map("platform_settings")
}

// ---------------------------------------------------------------------------
// Discovery
// ---------------------------------------------------------------------------

model SearchRun {
  id              String          @id @default(uuid(7)) @db.Char(36)
  organizationId  String          @db.Char(36)
  userId          String?         @db.Char(36)
  savedSearchId   String?         @db.Char(36)
  query           String          @db.VarChar(300)
  criteria        Json
  strategy        String?         @db.VarChar(40)
  status          SearchRunStatus @default(QUEUED)
  stage           String?         @db.VarChar(40)
  providerSummary Json?
  totalRaw        Int             @default(0)
  totalNormalized Int             @default(0)
  totalDeduped    Int             @default(0)
  totalNew        Int             @default(0)
  totalEnriched   Int             @default(0)
  error           String?         @db.Text
  jobId           String?         @db.Char(36)
  startedAt       DateTime?       @db.DateTime(3)
  completedAt     DateTime?       @db.DateTime(3)
  createdAt       DateTime        @default(now()) @db.DateTime(3)
  updatedAt       DateTime        @updatedAt @db.DateTime(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  savedSearch  SavedSearch?    @relation(fields: [savedSearchId], references: [id], onDelete: SetNull)
  providerRuns ProviderRun[]
  leads        SearchRunLead[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@map("search_runs")
}

model SavedSearch {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String    @db.Char(36)
  userId         String?   @db.Char(36)
  name           String    @db.VarChar(120)
  criteria       Json
  lastRunAt      DateTime? @db.DateTime(3)
  runCount       Int       @default(0)
  deletedAt      DateTime? @db.DateTime(3)
  createdAt      DateTime  @default(now()) @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         SearchRun[]

  @@index([organizationId, deletedAt])
  @@map("saved_searches")
}

/// One external provider execution (e.g. an Apify Actor run). Raw metadata and errors live here.
model ProviderRun {
  id             String            @id @default(uuid(7)) @db.Char(36)
  organizationId String            @db.Char(36)
  searchRunId    String?           @db.Char(36)
  purpose        String            @db.VarChar(40)
  provider       String            @db.VarChar(40)
  actorId        String            @db.VarChar(200)
  adapter        String?           @db.VarChar(80)
  externalRunId  String?           @db.VarChar(120)
  datasetId      String?           @db.VarChar(120)
  status         ProviderRunStatus @default(CREATED)
  input          Json?
  itemCount      Int?
  costUsd        Decimal?          @db.Decimal(10, 4)
  error          String?           @db.Text
  startedAt      DateTime?         @db.DateTime(3)
  finishedAt     DateTime?         @db.DateTime(3)
  createdAt      DateTime          @default(now()) @db.DateTime(3)
  updatedAt      DateTime          @updatedAt @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  searchRun    SearchRun?   @relation(fields: [searchRunId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([externalRunId])
  @@map("provider_runs")
}

/// Normalized lead entity. Denormalized "primary" fields exist for fast list rendering;
/// the authoritative detail lives in LeadSocialAccount / LeadContact.
model Lead {
  id               String           @id @default(uuid(7)) @db.Char(36)
  organizationId   String           @db.Char(36)
  dedupeKey        String           @db.VarChar(191)
  brandName        String           @db.VarChar(191)
  name             String?          @db.VarChar(191)
  primaryPlatform  Platform?
  username         String?          @db.VarChar(120)
  profileUrl       String?          @db.VarChar(500)
  inboxUrl         String?          @db.VarChar(500)
  externalId       String?          @db.VarChar(120)
  followers        Int?
  following        Int?
  postsCount       Int?
  bio              String?          @db.Text
  website          String?          @db.VarChar(500)
  websiteDomain    String?          @db.VarChar(191)
  email            String?          @db.VarChar(254)
  phone            String?          @db.VarChar(40)
  whatsapp         String?          @db.VarChar(40)
  country          String?          @db.VarChar(80)
  region           String?          @db.VarChar(80)
  city             String?          @db.VarChar(80)
  address          String?          @db.VarChar(300)
  category         String?          @db.VarChar(120)
  source           String?          @db.VarChar(40)
  sourceActor      String?          @db.VarChar(200)
  sourceTimestamp  DateTime?        @db.DateTime(3)
  timezone         String?          @db.VarChar(64)
  leadScore        Int              @default(0)
  scoreBreakdown   Json?
  status           LeadStatus       @default(DISCOVERED)
  isSaved          Boolean          @default(false)
  savedAt          DateTime?        @db.DateTime(3)
  savedByUserId    String?          @db.Char(36)
  clientId         String?          @unique @db.Char(36)
  enrichmentStatus EnrichmentStatus @default(NONE)
  enrichedAt       DateTime?        @db.DateTime(3)
  enrichmentError  String?          @db.Text
  notes            String?          @db.Text
  firstSearchRunId String?          @db.Char(36)
  discoveredAt     DateTime         @default(now()) @db.DateTime(3)
  lastSeenAt       DateTime         @default(now()) @db.DateTime(3)
  deletedAt        DateTime?        @db.DateTime(3)
  createdAt        DateTime         @default(now()) @db.DateTime(3)
  updatedAt        DateTime         @updatedAt @db.DateTime(3)

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  socialAccounts LeadSocialAccount[]
  contacts       LeadContact[]
  searchRuns     SearchRunLead[]
  tags           LeadTag[]
  notesList      Note[]

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, status, deletedAt])
  @@index([organizationId, isSaved])
  @@index([organizationId, leadScore])
  @@index([organizationId, followers])
  @@index([organizationId, websiteDomain])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, username])
  @@index([organizationId, createdAt])
  @@fulltext([brandName, bio])
  @@map("leads")
}

model LeadSocialAccount {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String    @db.Char(36)
  leadId         String    @db.Char(36)
  platform       Platform
  username       String?   @db.VarChar(120)
  profileUrl     String    @db.VarChar(500)
  externalId     String?   @db.VarChar(120)
  inboxUrl       String?   @db.VarChar(500)
  externalThreadId String? @db.VarChar(120)
  displayName    String?   @db.VarChar(191)
  followers      Int?
  following      Int?
  postsCount     Int?
  bio            String?   @db.Text
  category       String?   @db.VarChar(120)
  isBusiness     Boolean?
  isVerified     Boolean?
  isPrivate      Boolean?
  website        String?   @db.VarChar(500)
  email          String?   @db.VarChar(254)
  phone          String?   @db.VarChar(40)
  lastPostAt     DateTime? @db.DateTime(3)
  raw            Json?
  sourceProvider String    @db.VarChar(40)
  sourceActor    String?   @db.VarChar(200)
  providerRunId  String?   @db.Char(36)
  fetchedAt      DateTime  @default(now()) @db.DateTime(3)
  createdAt      DateTime  @default(now()) @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @db.DateTime(3)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([organizationId, platform, username])
  @@index([organizationId, platform, externalId])
  @@index([leadId])
  @@map("lead_social_accounts")
}

model LeadContact {
  id              String            @id @default(uuid(7)) @db.Char(36)
  organizationId  String            @db.Char(36)
  leadId          String            @db.Char(36)
  type            ContactType
  value           String            @db.VarChar(500)
  normalizedValue String            @db.VarChar(191)
  source          ContactSource
  sourceUrl       String?           @db.VarChar(500)
  confidence      ContactConfidence @default(PUBLIC)
  label           String?           @db.VarChar(80)
  isPrimary       Boolean           @default(false)
  createdAt       DateTime          @default(now()) @db.DateTime(3)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, type, normalizedValue])
  @@index([organizationId, type, normalizedValue])
  @@map("lead_contacts")
}

model SearchRunLead {
  id            String   @id @default(uuid(7)) @db.Char(36)
  searchRunId   String   @db.Char(36)
  leadId        String   @db.Char(36)
  rank          Int      @default(0)
  matchedExisting Boolean @default(false)
  matchedBy     String?  @db.VarChar(60)
  createdAt     DateTime @default(now()) @db.DateTime(3)

  searchRun SearchRun @relation(fields: [searchRunId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([searchRunId, leadId])
  @@index([leadId])
  @@map("search_run_leads")
}

