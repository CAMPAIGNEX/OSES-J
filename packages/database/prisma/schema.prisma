model Client {
  id              String       @id @default(uuid(7)) @db.Char(36)
  organizationId  String       @db.Char(36)
  cid             String       @db.VarChar(20)
  cidSequence     Int
  brandName       String       @db.VarChar(191)
  companyName     String?      @db.VarChar(191)
  category        String?      @db.VarChar(120)
  website         String?      @db.VarChar(500)
  websiteDomain   String?      @db.VarChar(191)
  email           String?      @db.VarChar(254)
  phone           String?      @db.VarChar(40)
  whatsapp        String?      @db.VarChar(40)
  country         String?      @db.VarChar(80)
  region          String?      @db.VarChar(80)
  city            String?      @db.VarChar(80)
  address         String?      @db.VarChar(300)
  timezone        String?      @db.VarChar(64)
  timezoneSource  String?      @db.VarChar(20)
  followers       Int?
  bio             String?      @db.Text
  source          String?      @db.VarChar(40)
  leadScore       Int          @default(0)
  status          ClientStatus @default(NEW)
  doNotContact    Boolean      @default(false)
  doNotContactReason String?   @db.VarChar(300)
  ownerUserId     String?      @db.Char(36)
  createdByUserId String?      @db.Char(36)
  lastContactedAt DateTime?    @db.DateTime(3)
  lastReplyAt     DateTime?    @db.DateTime(3)
  lastActivityAt  DateTime?    @db.DateTime(3)
  aiSummary       String?      @db.Text
  aiAnalysis      Json?
  deletedAt       DateTime?    @db.DateTime(3)
  createdAt       DateTime     @default(now()) @db.DateTime(3)
  updatedAt       DateTime     @updatedAt @db.DateTime(3)

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
