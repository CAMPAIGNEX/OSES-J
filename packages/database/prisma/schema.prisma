// Messaging
// ---------------------------------------------------------------------------

/// Official (OAuth) connection to a Meta asset: a Facebook Page and/or the Instagram professional account linked to it.
model SocialConnection {
  id                   String           @id @default(uuid(7)) @db.Char(36)
  organizationId       String           @db.Char(36)
  platform             Platform
  provider             String           @default("meta") @db.VarChar(40)
  externalAccountId    String           @db.VarChar(120)
  pageId               String?          @db.VarChar(120)
  username             String?          @db.VarChar(120)
  displayName          String?          @db.VarChar(191)
  accessTokenEncrypted String?          @db.Text
  tokenExpiresAt       DateTime?        @db.DateTime(3)
  scopes               Json?
  status               ConnectionStatus @default(CONNECTED)
  lastError            String?          @db.Text
  meta                 Json?
  connectedByUserId    String?          @db.Char(36)
  lastSyncedAt         DateTime?        @db.DateTime(3)
  createdAt            DateTime         @default(now()) @db.DateTime(3)
  updatedAt            DateTime         @updatedAt @db.DateTime(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([organizationId, platform, externalAccountId])
  @@index([platform, externalAccountId])
  @@map("social_connections")
}

model Conversation {
  id                    String             @id @default(uuid(7)) @db.Char(36)
  organizationId        String             @db.Char(36)
  clientId              String             @db.Char(36)
  channel               Platform
  clientSocialAccountId String?            @db.Char(36)
  socialConnectionId    String?            @db.Char(36)
  externalThreadId      String?            @db.VarChar(120)
  status                ConversationStatus @default(OPEN)
  lastMessageAt         DateTime?          @db.DateTime(3)
  lastInboundAt         DateTime?          @db.DateTime(3)
  lastOutboundAt        DateTime?          @db.DateTime(3)
  lastMessagePreview    String?            @db.VarChar(300)
  messageCount          Int                @default(0)
  unreadCount           Int                @default(0)
  assignedUserId        String?            @db.Char(36)
  aiStatus              String             @default("idle") @db.VarChar(30)
  lastIntent            String?            @db.VarChar(40)
  lastIntentConfidence  Float?
  summary               String?            @db.Text
  summaryUpdatedAt      DateTime?          @db.DateTime(3)
  needsHumanReview      Boolean            @default(false)
  needsHumanReason      String?            @db.VarChar(300)
  campaignId            String?            @db.Char(36)
  deletedAt             DateTime?          @db.DateTime(3)
  createdAt             DateTime           @default(now()) @db.DateTime(3)
  updatedAt             DateTime           @updatedAt @db.DateTime(3)

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client              Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientSocialAccount ClientSocialAccount? @relation(fields: [clientSocialAccountId], references: [id], onDelete: SetNull)
  socialConnection    SocialConnection?    @relation(fields: [socialConnectionId], references: [id], onDelete: SetNull)
  messages            Message[]
  scheduledMessages   ScheduledMessage[]
  messageJobs         MessageJob[]
  documents           Document[]

  @@unique([organizationId, channel, externalThreadId])
  @@index([organizationId, lastMessageAt])
  @@index([organizationId, status, deletedAt])
  @@index([clientId, channel])
  @@map("conversations")
}

model Message {
  id                 String            @id @default(uuid(7)) @db.Char(36)
  organizationId     String            @db.Char(36)
  conversationId     String            @db.Char(36)
  clientId           String            @db.Char(36)
  channel            Platform
  direction          MessageDirection
  authorType         MessageAuthorType
  userId             String?           @db.Char(36)
  body               String            @db.Text
  status             MessageStatus     @default(DRAFT)
  approvalStatus     ApprovalStatus    @default(NONE)
  approvedByUserId   String?           @db.Char(36)
  approvedAt         DateTime?         @db.DateTime(3)
  providerKey        String?           @db.VarChar(40)
  providerMessageId  String?           @db.VarChar(191)
  externalMessageId  String?           @db.VarChar(191)
  aiGenerated        Boolean           @default(false)
  aiModel            String?           @db.VarChar(120)
  aiActionLogId      String?           @db.Char(36)
  campaignId         String?           @db.Char(36)
  scheduledMessageId String?           @db.Char(36)
  sentAt             DateTime?         @db.DateTime(3)
  deliveredAt        DateTime?         @db.DateTime(3)
  seenAt             DateTime?         @db.DateTime(3)
  failedAt           DateTime?         @db.DateTime(3)
  failureReason      String?           @db.Text
  errorClass         ErrorClass?
  meta               Json?
  createdAt          DateTime          @default(now()) @db.DateTime(3)
  updatedAt          DateTime          @updatedAt @db.DateTime(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  client       Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]
  job          MessageJob?

  @@unique([organizationId, channel, externalMessageId])
  @@index([conversationId, createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, direction, status])
  @@index([campaignId])
  @@map("messages")
}

model MessageAttachment {
  id         String   @id @default(uuid(7)) @db.Char(36)
  messageId  String   @db.Char(36)
  documentId String?  @db.Char(36)
  name       String   @db.VarChar(255)
  mimeType   String?  @db.VarChar(120)
  sizeBytes  Int?
  url        String?  @db.VarChar(1000)
  createdAt  DateTime @default(now()) @db.DateTime(3)

  message  Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@map("message_attachments")
}

model ScheduledMessage {
  id              String                 @id @default(uuid(7)) @db.Char(36)
  organizationId  String                 @db.Char(36)
  clientId        String                 @db.Char(36)
  conversationId  String?                @db.Char(36)
  channel         Platform
  body            String                 @db.Text
  scheduledAt     DateTime               @db.DateTime(3)
  timezone        String                 @db.VarChar(64)
  timezoneMode    String                 @default("client") @db.VarChar(20)
  status          ScheduledMessageStatus @default(SCHEDULED)
  createdByType   ActorType              @default(USER)
  createdByUserId String?                @db.Char(36)
  campaignId      String?                @db.Char(36)
  campaignLeadId  String?                @db.Char(36)
  followUpStep    Int?
  messageId       String?                @db.Char(36)
  aiActionLogId   String?                @db.Char(36)
  jobId           String?                @db.Char(36)
  error           String?                @db.Text
  sentAt          DateTime?              @db.DateTime(3)
  cancelledAt     DateTime?              @db.DateTime(3)
  createdAt       DateTime               @default(now()) @db.DateTime(3)
  updatedAt       DateTime               @updatedAt @db.DateTime(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, scheduledAt])
  @@index([clientId, status])
  @@map("scheduled_messages")
}

/// Browser/Apify/Meta delivery job for one outbound message.
model MessageJob {
  id                String             @id @default(uuid(7)) @db.Char(36)
  organizationId    String             @db.Char(36)
  messageId         String             @unique @db.Char(36)
  conversationId    String             @db.Char(36)
  clientId          String             @db.Char(36)
  provider          MessageJobProvider
  status            MessageJobStatus   @default(QUEUED)
  target            Json
  payload           Json
  priority          Int                @default(5)
  attempts          Int                @default(0)
  maxAttempts       Int                @default(3)
  scheduledAt       DateTime           @default(now()) @db.DateTime(3)
  claimedAt         DateTime?          @db.DateTime(3)
  claimedByDeviceId String?            @db.Char(36)
  leaseExpiresAt    DateTime?          @db.DateTime(3)
  lastHeartbeatAt   DateTime?          @db.DateTime(3)
  progressDetail    String?            @db.VarChar(500)
  result            Json?
  errorCode         String?            @db.VarChar(60)
  errorMessage      String?            @db.Text
  errorClass        ErrorClass?
  providerRunId     String?            @db.Char(36)
  completedAt       DateTime?          @db.DateTime(3)
  cancelledAt       DateTime?          @db.DateTime(3)
  createdAt         DateTime           @default(now()) @db.DateTime(3)
  updatedAt         DateTime           @updatedAt @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId, provider, status, scheduledAt])
  @@index([organizationId, createdAt])
  @@map("message_jobs")
}

model ExtensionDevice {
  id                    String                @id @default(uuid(7)) @db.Char(36)
  organizationId        String                @db.Char(36)
  userId                String                @db.Char(36)
  name                  String                @db.VarChar(120)
  browser               String?               @db.VarChar(120)
  extensionVersion      String?               @db.VarChar(40)
  status                ExtensionDeviceStatus @default(PENDING)
