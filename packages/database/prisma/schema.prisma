}

model AuditLog {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String?   @db.Char(36)
  userId         String?   @db.Char(36)
  actorType      ActorType @default(USER)
  action         String    @db.VarChar(80)
  entityType     String?   @db.VarChar(40)
  entityId       String?   @db.VarChar(64)
  meta           Json?
  ip             String?   @db.VarChar(64)
  userAgent      String?   @db.VarChar(255)
  createdAt      DateTime  @default(now()) @db.DateTime(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

model UsageRecord {
  id             String      @id @default(uuid(7)) @db.Char(36)
  organizationId String      @db.Char(36)
  metric         UsageMetric
  day            DateTime    @db.Date
  quantity       Int         @default(0)
  meta           Json?
  updatedAt      DateTime    @updatedAt @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric, day])
  @@map("usage_records")
}

// ---------------------------------------------------------------------------
// Documents & trash
// ---------------------------------------------------------------------------

model Document {
  id               String       @id @default(uuid(7)) @db.Char(36)
  organizationId   String       @db.Char(36)
  name             String       @db.VarChar(255)
  originalName     String       @db.VarChar(255)
  mimeType         String       @db.VarChar(120)
  sizeBytes        Int
  storageKey       String       @db.VarChar(500)
  storageDriver    String       @default("local") @db.VarChar(20)
  kind             DocumentKind @default(OTHER)
  clientId         String?      @db.Char(36)
  conversationId   String?      @db.Char(36)
  campaignId       String?      @db.Char(36)
  uploadedByUserId String?      @db.Char(36)
  checksum         String?      @db.VarChar(64)
  deletedAt        DateTime?    @db.DateTime(3)
  createdAt        DateTime     @default(now()) @db.DateTime(3)
  updatedAt        DateTime     @updatedAt @db.DateTime(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client             Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  conversation       Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  campaign           Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  knowledgeDocument  KnowledgeDocument?
  messageAttachments MessageAttachment[]

  @@index([organizationId, kind, deletedAt])
  @@index([clientId])
  @@map("documents")
}

model TrashItem {
  id              String          @id @default(uuid(7)) @db.Char(36)
  organizationId  String          @db.Char(36)
  entityType      TrashEntityType
  entityId        String          @db.Char(36)
  label           String          @db.VarChar(255)
  deletedByUserId String?         @db.Char(36)
  deletedAt       DateTime        @default(now()) @db.DateTime(3)
  purgeAt         DateTime        @db.DateTime(3)
  restoredAt      DateTime?       @db.DateTime(3)
  purgedAt        DateTime?       @db.DateTime(3)
  meta            Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId])
  @@index([organizationId, restoredAt, purgedAt])
  @@index([purgeAt])
  @@map("trash_items")
}

/// Configurable external provider (e.g. which Apify Actor handles Instagram discovery).
/// organizationId = null means a platform-wide default.
model ProviderConfig {
  id             String         @id @default(uuid(7)) @db.Char(36)
  organizationId String?        @db.Char(36)
  domain         ProviderDomain
  provider       String         @db.VarChar(40)
  platform       String         @db.VarChar(20)
  actorId        String         @db.VarChar(200)
  adapter        String         @db.VarChar(80)
  enabled        Boolean        @default(true)
  priority       Int            @default(1)
  costLimitUsd   Decimal?       @db.Decimal(10, 2)
  timeoutSec     Int            @default(600)
  settings       Json?
  createdAt      DateTime       @default(now()) @db.DateTime(3)
  updatedAt      DateTime       @updatedAt @db.DateTime(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, domain, platform, enabled, priority])
  @@map("provider_configs")
}

// ---------------------------------------------------------------------------
// Competitor & trend analysis
// ---------------------------------------------------------------------------

model CompetitorSearch {
  id              String         @id @default(uuid(7)) @db.Char(36)
  organizationId  String         @db.Char(36)
  name            String?        @db.VarChar(140)
  criteria        Json
  status          AnalysisStatus @default(QUEUED)
  resultSummary   Json?
  aiReport        String?        @db.Text
  itemCount       Int            @default(0)
  jobId           String?        @db.Char(36)
  error           String?        @db.Text
  createdByUserId String?        @db.Char(36)
  deletedAt       DateTime?      @db.DateTime(3)
  createdAt       DateTime       @default(now()) @db.DateTime(3)
  updatedAt       DateTime       @updatedAt @db.DateTime(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        ContentItem[]

  @@index([organizationId, createdAt])
  @@map("competitor_searches")
}

model TrendSearch {
  id              String         @id @default(uuid(7)) @db.Char(36)
  organizationId  String         @db.Char(36)
  name            String?        @db.VarChar(140)
  criteria        Json
  status          AnalysisStatus @default(QUEUED)
  resultSummary   Json?
  aiReport        String?        @db.Text
  itemCount       Int            @default(0)
  jobId           String?        @db.Char(36)
  error           String?        @db.Text
  createdByUserId String?        @db.Char(36)
  deletedAt       DateTime?      @db.DateTime(3)
  createdAt       DateTime       @default(now()) @db.DateTime(3)
  updatedAt       DateTime       @updatedAt @db.DateTime(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        ContentItem[]

  @@index([organizationId, createdAt])
  @@map("trend_searches")
}

/// Normalized public post/content item collected for analysis.
model ContentItem {
  id                 String    @id @default(uuid(7)) @db.Char(36)
  organizationId     String    @db.Char(36)
  competitorSearchId String?   @db.Char(36)
  trendSearchId      String?   @db.Char(36)
  platform           Platform
  accountUsername    String?   @db.VarChar(120)
  accountName        String?   @db.VarChar(191)
  accountUrl         String?   @db.VarChar(500)
  postUrl            String?   @db.VarChar(500)
  externalId         String?   @db.VarChar(120)
  postedAt           DateTime? @db.DateTime(3)
  caption            String?   @db.Text
  hashtags           Json?
  likes              Int?
  comments           Int?
  views              Int?
  mediaType          String?   @db.VarChar(30)
  location           String?   @db.VarChar(191)
  category           String?   @db.VarChar(120)
  raw                Json?
  createdAt          DateTime  @default(now()) @db.DateTime(3)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  competitorSearch CompetitorSearch? @relation(fields: [competitorSearchId], references: [id], onDelete: Cascade)
  trendSearch      TrendSearch?      @relation(fields: [trendSearchId], references: [id], onDelete: Cascade)

  @@index([competitorSearchId])
  @@index([trendSearchId])
  @@index([organizationId, platform, postedAt])
  @@map("content_items")
}
